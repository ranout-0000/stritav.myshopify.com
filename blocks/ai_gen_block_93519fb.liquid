{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-reviews-slider-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-reviews-slider__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: 40px;
  }

  .ai-reviews-slider__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 10px;
  }

  .ai-reviews-slider__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
  }

  .ai-reviews-slider__container-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-reviews-slider__track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.5s ease;
    gap: {{ block.settings.card_gap }}px;
  }

  .ai-reviews-slider__card-{{ ai_gen_id }} {
    flex: 0 0 calc(100% - {{ block.settings.card_gap }}px);
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .ai-reviews-slider__stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
    margin-bottom: 15px;
  }

  .ai-reviews-slider__star-{{ ai_gen_id }} {
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
    fill: {{ block.settings.star_color }};
  }

  .ai-reviews-slider__star--empty-{{ ai_gen_id }} {
    fill: {{ block.settings.star_empty_color }};
  }

  .ai-reviews-slider__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.review_text_size }}px;
    color: {{ block.settings.review_text_color }};
    line-height: 1.6;
    margin-bottom: 20px;
  }

  .ai-reviews-slider__author-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ai-reviews-slider__avatar-{{ ai_gen_id }} {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
  }

  .ai-reviews-slider__avatar-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-reviews-slider__avatar-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.star_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    font-weight: 600;
    font-size: 20px;
  }

  .ai-reviews-slider__author-info-{{ ai_gen_id }} {
    flex-grow: 1;
  }

  .ai-reviews-slider__author-name-{{ ai_gen_id }} {
    font-weight: 600;
    font-size: 16px;
    color: {{ block.settings.author_name_color }};
    margin: 0 0 4px;
  }

  .ai-reviews-slider__author-title-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.author_title_color }};
    margin: 0;
  }

  .ai-reviews-slider__controls-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    margin-top: 30px;
  }

  .ai-reviews-slider__button-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_color }};
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease;
  }

  .ai-reviews-slider__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  .ai-reviews-slider__button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-reviews-slider__dots-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
  }

  .ai-reviews-slider__dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background-color 0.3s ease;
  }

  .ai-reviews-slider__dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.dot_active_color }};
  }

  @media screen and (min-width: 750px) {
    .ai-reviews-slider__card-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - ({{ block.settings.card_gap }}px * ({{ block.settings.cards_per_view }} - 1))) / {{ block.settings.cards_per_view }});
    }
  }

  @media screen and (max-width: 749px) {
    .ai-reviews-slider__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-reviews-slider__subtitle-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subtitle_size }}px * 0.9);
    }
  }
{% endstyle %}

<reviews-slider-{{ ai_gen_id }} class="ai-reviews-slider-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.title != blank or block.settings.subtitle != blank %}
    <div class="ai-reviews-slider__header-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-reviews-slider__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}
      {% if block.settings.subtitle != blank %}
        <p class="ai-reviews-slider__subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
      {% endif %}
    </div>
  {% endif %}

  <div class="ai-reviews-slider__container-{{ ai_gen_id }}">
    <div class="ai-reviews-slider__track-{{ ai_gen_id }}" data-track>
      {% for i in (1..6) %}
        {% liquid
          assign review_enabled_key = 'review_' | append: i | append: '_enabled'
          assign review_text_key = 'review_' | append: i | append: '_text'
          assign review_rating_key = 'review_' | append: i | append: '_rating'
          assign review_author_key = 'review_' | append: i | append: '_author'
          assign review_title_key = 'review_' | append: i | append: '_title'
          assign review_image_key = 'review_' | append: i | append: '_image'

          assign review_enabled = block.settings[review_enabled_key]
          assign review_text = block.settings[review_text_key]
          assign review_rating = block.settings[review_rating_key]
          assign review_author = block.settings[review_author_key]
          assign review_title = block.settings[review_title_key]
          assign review_image = block.settings[review_image_key]
        %}

        {% if review_enabled %}
          <div class="ai-reviews-slider__card-{{ ai_gen_id }}">
            <div class="ai-reviews-slider__stars-{{ ai_gen_id }}">
              {% for star in (1..5) %}
                <svg class="ai-reviews-slider__star-{{ ai_gen_id }} {% if star > review_rating %}ai-reviews-slider__star--empty-{{ ai_gen_id }}{% endif %}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              {% endfor %}
            </div>

            {% if review_text != blank %}
              <div class="ai-reviews-slider__text-{{ ai_gen_id }}">{{ review_text }}</div>
            {% endif %}

            <div class="ai-reviews-slider__author-{{ ai_gen_id }}">
              <div class="ai-reviews-slider__avatar-{{ ai_gen_id }}">
                {% if review_image %}
                  <img src="{{ review_image | image_url: width: 100 }}" alt="{{ review_author | escape }}" loading="lazy" width="50" height="50">
                {% else %}
                  <div class="ai-reviews-slider__avatar-placeholder-{{ ai_gen_id }}">
                    {{ review_author | slice: 0 | upcase }}
                  </div>
                {% endif %}
              </div>
              <div class="ai-reviews-slider__author-info-{{ ai_gen_id }}">
                {% if review_author != blank %}
                  <div class="ai-reviews-slider__author-name-{{ ai_gen_id }}">{{ review_author }}</div>
                {% endif %}
                {% if review_title != blank %}
                  <div class="ai-reviews-slider__author-title-{{ ai_gen_id }}">{{ review_title }}</div>
                {% endif %}
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <div class="ai-reviews-slider__controls-{{ ai_gen_id }}">
    <button class="ai-reviews-slider__button-{{ ai_gen_id }}" data-prev aria-label="Previous review">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>

    <div class="ai-reviews-slider__dots-{{ ai_gen_id }}" data-dots></div>

    <button class="ai-reviews-slider__button-{{ ai_gen_id }}" data-next aria-label="Next review">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  </div>
</reviews-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class ReviewsSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.cardsPerView = window.innerWidth >= 750 ? {{ block.settings.cards_per_view }} : 1;
      }

      connectedCallback() {
        this.track = this.querySelector('[data-track]');
        this.prevButton = this.querySelector('[data-prev]');
        this.nextButton = this.querySelector('[data-next]');
        this.dotsContainer = this.querySelector('[data-dots]');
        this.cards = this.track.querySelectorAll('.ai-reviews-slider__card-{{ ai_gen_id }}');
        this.totalCards = this.cards.length;
        this.totalSlides = Math.ceil(this.totalCards / this.cardsPerView);

        this.createDots();
        this.updateSlider();
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => this.prev());
        this.nextButton.addEventListener('click', () => this.next());

        window.addEventListener('resize', () => {
          const newCardsPerView = window.innerWidth >= 750 ? {{ block.settings.cards_per_view }} : 1;
          if (newCardsPerView !== this.cardsPerView) {
            this.cardsPerView = newCardsPerView;
            this.totalSlides = Math.ceil(this.totalCards / this.cardsPerView);
            this.currentIndex = Math.min(this.currentIndex, this.totalSlides - 1);
            this.createDots();
            this.updateSlider();
          }
        });
      }

      createDots() {
        this.dotsContainer.innerHTML = '';
        for (let i = 0; i < this.totalSlides; i++) {
          const dot = document.createElement('button');
          dot.classList.add('ai-reviews-slider__dot-{{ ai_gen_id }}');
          dot.setAttribute('aria-label', `Go to slide ${i + 1}`);
          if (i === this.currentIndex) {
            dot.classList.add('active');
          }
          dot.addEventListener('click', () => this.goToSlide(i));
          this.dotsContainer.appendChild(dot);
        }
      }

      updateSlider() {
        const offset = -this.currentIndex * 100;
        this.track.style.transform = `translateX(${offset}%)`;

        this.prevButton.disabled = this.currentIndex === 0;
        this.nextButton.disabled = this.currentIndex === this.totalSlides - 1;

        const dots = this.dotsContainer.querySelectorAll('.ai-reviews-slider__dot-{{ ai_gen_id }}');
        dots.forEach((dot, index) => {
          if (index === this.currentIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      prev() {
        if (this.currentIndex > 0) {
          this.currentIndex--;
          this.updateSlider();
        }
      }

      next() {
        if (this.currentIndex < this.totalSlides - 1) {
          this.currentIndex++;
          this.updateSlider();
        }
      }

      goToSlide(index) {
        this.currentIndex = index;
        this.updateSlider();
      }
    }

    customElements.define('reviews-slider-{{ ai_gen_id }}', ReviewsSlider{{ ai_gen_id }});
  })();
</script>

