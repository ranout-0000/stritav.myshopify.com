{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-plates-banner-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    min-height: {{ block.settings.banner_height_desktop }}px;
    background: {{ block.settings.background_color }};
    overflow: hidden;
  }

  .ai-plates-banner__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      {{ block.settings.overlay_angle }}deg,
      {{ block.settings.overlay_color_1 }},
      {{ block.settings.overlay_color_2 }}
    );
    opacity: {{ block.settings.overlay_opacity }};
    z-index: 1;
  }

  .ai-plates-banner__background-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .ai-plates-banner__background-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #1a1a1a;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 0;
  }

  .ai-plates-banner__background-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    opacity: 0.1;
  }

  .ai-plates-banner__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 24px;
    background: rgba(0, 0, 0, 0.7);
    color: #fddc00;
    font-size: 14px;
    border-radius: 4px;
    z-index: 10;
  }

  .ai-plates-banner__content-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: {{ block.settings.content_alignment }};
    justify-content: center;
    min-height: {{ block.settings.banner_height_desktop }}px;
    padding: 60px 40px;
    text-align: {{ block.settings.text_alignment }};
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto;
  }

  .ai-plates-banner__badge-{{ ai_gen_id }} {
    display: inline-block;
    padding: 8px 20px;
    background: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    font-size: {{ block.settings.badge_font_size }}px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    border-radius: 30px;
    margin-bottom: 20px;
  }

  .ai-plates-banner__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size_desktop }}px;
    font-weight: 700;
    color: {{ block.settings.heading_color }};
    margin: 0 0 20px;
    line-height: 1.1;
    text-transform: {{ block.settings.heading_transform }};
  }

  .ai-plates-banner__subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0 0 30px;
    line-height: 1.5;
    max-width: 700px;
  }

  .ai-plates-banner__buttons-{{ ai_gen_id }} {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
    justify-content: {{ block.settings.content_alignment }};
  }

  .ai-plates-banner__button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 40px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    text-decoration: none;
    border-radius: {{ block.settings.button_radius }}px;
    transition: all 0.3s ease;
    border: 2px solid transparent;
  }

  .ai-plates-banner__button--primary-{{ ai_gen_id }} {
    background: {{ block.settings.primary_button_bg }};
    color: {{ block.settings.primary_button_color }};
    border-color: {{ block.settings.primary_button_bg }};
  }

  .ai-plates-banner__button--primary-{{ ai_gen_id }}:hover {
    background: {{ block.settings.primary_button_hover_bg }};
    color: {{ block.settings.primary_button_hover_color }};
    border-color: {{ block.settings.primary_button_hover_bg }};
    transform: translateY(-2px);
  }

  .ai-plates-banner__button--secondary-{{ ai_gen_id }} {
    background: transparent;
    color: {{ block.settings.secondary_button_color }};
    border-color: {{ block.settings.secondary_button_border }};
  }

  .ai-plates-banner__button--secondary-{{ ai_gen_id }}:hover {
    background: {{ block.settings.secondary_button_hover_bg }};
    color: {{ block.settings.secondary_button_hover_color }};
    border-color: {{ block.settings.secondary_button_hover_bg }};
    transform: translateY(-2px);
  }

  .ai-plates-banner__features-{{ ai_gen_id }} {
    display: flex;
    gap: 30px;
    margin-top: 40px;
    flex-wrap: wrap;
    justify-content: {{ block.settings.content_alignment }};
  }

  .ai-plates-banner__feature-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 10px;
    color: {{ block.settings.feature_text_color }};
    font-size: 14px;
  }

  .ai-plates-banner__feature-icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    color: {{ block.settings.feature_icon_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-plates-banner-{{ ai_gen_id }} {
      min-height: {{ block.settings.banner_height_mobile }}px;
    }

    .ai-plates-banner__content-{{ ai_gen_id }} {
      min-height: {{ block.settings.banner_height_mobile }}px;
      padding: 40px 20px;
      align-items: center;
      text-align: center;
    }

    .ai-plates-banner__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-plates-banner__subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.9 }}px;
    }

    .ai-plates-banner__buttons-{{ ai_gen_id }} {
      flex-direction: column;
      width: 100%;
      justify-content: center;
    }

    .ai-plates-banner__button-{{ ai_gen_id }} {
      width: 100%;
      max-width: 300px;
    }

    .ai-plates-banner__features-{{ ai_gen_id }} {
      justify-content: center;
      gap: 20px;
    }
  }
{% endstyle %}

<elite-plates-banner-{{ ai_gen_id }} class="ai-plates-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.background_image %}
    <img
      src="{{ block.settings.background_image | image_url: width: 2000 }}"
      alt="{{ block.settings.background_image.alt | escape }}"
      loading="lazy"
      width="{{ block.settings.background_image.width }}"
      height="{{ block.settings.background_image.height }}"
      class="ai-plates-banner__background-{{ ai_gen_id }}"
    >
  {% else %}
    <div class="ai-plates-banner__background-placeholder-{{ ai_gen_id }}">
      {{ 'hero-apparel-1' | placeholder_svg_tag }}
    </div>
    <div class="ai-plates-banner__empty-state-{{ ai_gen_id }}">
      Add a background image to complete your banner
    </div>
  {% endif %}

  {% if block.settings.show_overlay %}
    <div class="ai-plates-banner__overlay-{{ ai_gen_id }}"></div>
  {% endif %}

  <div class="ai-plates-banner__content-{{ ai_gen_id }}">
    {% if block.settings.badge_text != blank %}
      <span class="ai-plates-banner__badge-{{ ai_gen_id }}">
        {{ block.settings.badge_text }}
      </span>
    {% endif %}

    {% if block.settings.heading != blank %}
      <h1 class="ai-plates-banner__heading-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </h1>
    {% endif %}

    {% if block.settings.subheading != blank %}
      <div class="ai-plates-banner__subheading-{{ ai_gen_id }}">
        {{ block.settings.subheading }}
      </div>
    {% endif %}

    {% if block.settings.primary_button_label != blank or block.settings.secondary_button_label != blank %}
      <div class="ai-plates-banner__buttons-{{ ai_gen_id }}">
        {% if block.settings.primary_button_label != blank %}
          <a
            href="{{ block.settings.primary_button_link }}"
            class="ai-plates-banner__button-{{ ai_gen_id }} ai-plates-banner__button--primary-{{ ai_gen_id }}"
          >
            {{ block.settings.primary_button_label }}
          </a>
        {% endif %}

        {% if block.settings.secondary_button_label != blank %}
          <a
            href="{{ block.settings.secondary_button_link }}"
            class="ai-plates-banner__button-{{ ai_gen_id }} ai-plates-banner__button--secondary-{{ ai_gen_id }}"
          >
            {{ block.settings.secondary_button_label }}
          </a>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.show_features %}
      <div class="ai-plates-banner__features-{{ ai_gen_id }}">
        {% if block.settings.feature_1_text != blank %}
          <div class="ai-plates-banner__feature-{{ ai_gen_id }}">
            <svg class="ai-plates-banner__feature-icon-{{ ai_gen_id }}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>{{ block.settings.feature_1_text }}</span>
          </div>
        {% endif %}

        {% if block.settings.feature_2_text != blank %}
          <div class="ai-plates-banner__feature-{{ ai_gen_id }}">
            <svg class="ai-plates-banner__feature-icon-{{ ai_gen_id }}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>{{ block.settings.feature_2_text }}</span>
          </div>
        {% endif %}

        {% if block.settings.feature_3_text != blank %}
          <div class="ai-plates-banner__feature-{{ ai_gen_id }}">
            <svg class="ai-plates-banner__feature-icon-{{ ai_gen_id }}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>{{ block.settings.feature_3_text }}</span>
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</elite-plates-banner-{{ ai_gen_id }}>

<script>
  (function() {
    class ElitePlatesBanner{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupParallax();
      }

      setupParallax() {
        const backgroundImage = this.querySelector('.ai-plates-banner__background-{{ ai_gen_id }}');
        if (!backgroundImage) return;

        window.addEventListener('scroll', () => {
          const scrolled = window.pageYOffset;
          const rate = scrolled * 0.5;
          backgroundImage.style.transform = `translateY(${rate}px)`;
        });
      }
    }

    customElements.define('elite-plates-banner-{{ ai_gen_id }}', ElitePlatesBanner{{ ai_gen_id }});
  })();
</script>

