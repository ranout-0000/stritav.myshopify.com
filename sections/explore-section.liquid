{% comment %} {% schema %}
{
  "name": "Explore Plate Styles",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffd400" },
    { "type": "color", "id": "text_color", "label": "Heading Color", "default": "#000000" },
    { "type": "color", "id": "button_color", "label": "Button Color", "default": "#000000" },
    { "type": "url", "id": "all_link", "label": "Shop All Link" }
  ],
  "blocks": [
    {
      "type": "plate",
      "name": "Plate",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "4D Plates" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Explore Plate Styles" }]
}
{% endschema %}

<section id="plate-{{ section.id }}" class="explore">
  <div class="page-width">
    
    <h2 class="explore-title">EXPLORE OUR PLATE STYLES</h2>

    <div class="explore-wrapper">
      
      <button class="nav prev">‹</button>

      <div class="slider">
        {% for block in section.blocks %}
        <div class="card">
          
          {% if block.settings.image %}
          <div class="img">
            <img src="{{ block.settings.image | image_url: width: 900 }}">
          </div>
          {% endif %}

          <div class="content">
            <h3>{{ block.settings.title }}</h3>
            <a href="{{ block.settings.link }}" class="btn">SHOP NOW</a>
          </div>

        </div>
        {% endfor %}
      </div>

      <button class="nav next">›</button>
    </div>

    <!-- DOTS -->
    <div class="dots"></div>

    <!-- CTA -->
    {% if section.settings.all_link %}
    <div class="all-btn-wrap">
      <a href="{{ section.settings.all_link }}" class="all-btn">
        SHOP ALL STYLES
      </a>
    </div>
    {% endif %}

  </div>
</section>

<style>
#plate-{{ section.id }} {
  background: {{ section.settings.bg_color }};
  padding: 70px 0;
}

/* TITLE */
#plate-{{ section.id }} .explore-title {
  text-align: center;
  font-size: 34px;
  font-weight: 800;
  color: {{ section.settings.text_color }};
  margin-bottom: 50px;
}

/* SLIDER */
#plate-{{ section.id }} .explore-wrapper {
  position: relative;
}

#plate-{{ section.id }} .slider {
  display: flex;
  gap: 20px;
  overflow-x: auto;
  scroll-behavior: smooth;
  padding: 10px 5px;
}

#plate-{{ section.id }} .slider::-webkit-scrollbar {
  display: none;
}

/* CARD */
#plate-{{ section.id }} .card {
  min-width: calc(33.33% - 14px);
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
  flex-shrink: 0;
  transition: 0.3s;
  box-shadow: 0 5px 15px rgba(0,0,0,0.08);
}

#plate-{{ section.id }} .card:hover {
  transform: translateY(-6px);
}

/* IMAGE */
#plate-{{ section.id }} .img img {
  width: 100%;
  height: 260px;
  object-fit: cover;
}

/* CONTENT */
#plate-{{ section.id }} .content {
  background: #000;
  color: #fff;
  text-align: center;
  padding: 25px 15px;
}

#plate-{{ section.id }} .content h3 {
  margin-bottom: 12px;
  font-size: 20px;
}

/* BUTTON */
#plate-{{ section.id }} .btn {
  background: {{ section.settings.button_color }};
  color: #fff;
  padding: 10px 18px;
  font-size: 14px;
  border-radius: 6px;
  text-decoration: none;
}

/* NAV */
#plate-{{ section.id }} .nav {
  position: absolute;
  top: 45%;
  transform: translateY(-50%);
  width: 42px;
  height: 42px;
  border-radius: 50%;
  border: none;
  background: #fff;
  cursor: pointer;
  font-size: 20px;
  z-index: 5;
}

#plate-{{ section.id }} .prev { left: 0; }
#plate-{{ section.id }} .next { right: 0; }

/* DOTS */
#plate-{{ section.id }} .dots {
  text-align: center;
  margin-top: 25px;
}

#plate-{{ section.id }} .dots span {
  display: inline-block;
  width: 8px;
  height: 8px;
  background: #ddd;
  margin: 5px;
  border-radius: 50%;
  cursor: pointer;
}

#plate-{{ section.id }} .dots .active {
  background: #000;
}

/* CTA */
#plate-{{ section.id }} .all-btn-wrap {
  text-align: center;
  margin-top: 35px;
}

#plate-{{ section.id }} .all-btn {
  background: #333;
  color: #fff;
  padding: 12px 25px;
  border-radius: 6px;
  text-decoration: none;
  font-weight: 600;
}

/* RESPONSIVE */
@media (max-width: 1024px) {
  #plate-{{ section.id }} .card {
    min-width: calc(50% - 10px);
  }
}

@media (max-width: 600px) {
  #plate-{{ section.id }} .card {
    min-width: 85%;
  }

  #plate-{{ section.id }} .explore-title {
    font-size: 24px;
  }
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const section = document.querySelector("#plate-{{ section.id }}");
  const slider = section.querySelector(".slider");
  const next = section.querySelector(".next");
  const prev = section.querySelector(".prev");
  const dotsWrap = section.querySelector(".dots");

  let scrollAmount = 320;

  next.onclick = () => slider.scrollBy({ left: scrollAmount, behavior: "smooth" });
  prev.onclick = () => slider.scrollBy({ left: -scrollAmount, behavior: "smooth" });

  /* DOTS */
  const cards = section.querySelectorAll(".card");
  cards.forEach((_, i) => {
    let dot = document.createElement("span");
    if (i === 0) dot.classList.add("active");

    dot.onclick = () => {
      slider.scrollTo({
        left: i * scrollAmount,
        behavior: "smooth"
      });
      document.querySelectorAll(".dots span").forEach(d => d.classList.remove("active"));
      dot.classList.add("active");
    };

    dotsWrap.appendChild(dot);
  });
});
</script>

