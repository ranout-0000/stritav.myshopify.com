 {% schema %}
{
  "name": "Explore Plate Styles",
  "settings": [
    { "type": "text", "id": "heading", "label": "Section Heading", "default": "EXPLORE OUR PLATE STYLES" },

    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffd400" },
    { "type": "color", "id": "text_color", "label": "Heading Color", "default": "#000000" },
    { "type": "color", "id": "button_color", "label": "Button Color", "default": "#000000" },

    { "type": "text", "id": "button_label", "label": "Card Button Text", "default": "SHOP NOW" },
    { "type": "text", "id": "cta_label", "label": "CTA Button Text", "default": "SHOP ALL STYLES" },
    { "type": "url", "id": "all_link", "label": "Shop All Link" }
  ],

  "blocks": [
    {
      "type": "plate",
      "name": "Plate",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "4D Plates" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],

  "presets": [
    { "name": "Explore Plate Styles" }
  ]
}
{% endschema %}


<section id="plate-{{ section.id }}" class="explore">
  <div class="page-width">

    <h2 class="explore-title">
      {{ section.settings.heading }}
    </h2>

    <div class="explore-wrapper">

      <button class="nav prev">‹</button>

      <div class="slider">
        {% for block in section.blocks %}
          <div class="card" {{ block.shopify_attributes }}>

            {% if block.settings.image %}
              <div class="img">
                <img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.title }}">
              </div>
            {% endif %}

            <div class="content">
              <h3>{{ block.settings.title }}</h3>

              {% if block.settings.link != blank %}
                <a href="{{ block.settings.link }}" class="btn">
                  {{ section.settings.button_label }}
                </a>
              {% endif %}
            </div>

          </div>
        {% endfor %}
      </div>

      <button class="nav next">›</button>
    </div>

    <div class="dots"></div>

    {% if section.settings.all_link != blank %}
      <div class="all-btn-wrap">
        <a href="{{ section.settings.all_link }}" class="all-btn">
          {{ section.settings.cta_label }}
        </a>
      </div>
    {% endif %}

  </div>
</section>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const section = document.querySelector("#plate-{{ section.id }}");
  if (!section) return;

  const slider = section.querySelector(".slider");
  const next = section.querySelector(".next");
  const prev = section.querySelector(".prev");
  const dotsWrap = section.querySelector(".dots");

  const cards = section.querySelectorAll(".card");

  function getScrollAmount() {
    return cards[0]?.offsetWidth + 16 || 300;
  }

  next.onclick = () =>
    slider.scrollBy({ left: getScrollAmount(), behavior: "smooth" });

  prev.onclick = () =>
    slider.scrollBy({ left: -getScrollAmount(), behavior: "smooth" });

  // dots
  cards.forEach((_, i) => {
    const dot = document.createElement("span");
    if (i === 0) dot.classList.add("active");

    dot.onclick = () => {
      slider.scrollTo({
        left: i * getScrollAmount(),
        behavior: "smooth"
      });

      section.querySelectorAll(".dots span").forEach(d => d.classList.remove("active"));
      dot.classList.add("active");
    };

    dotsWrap.appendChild(dot);
  });
});

</script>


