{% schema %}
{
  "name": "Social Media Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Follow Us"
    },
     {
    "type": "color",
    "id": "bg_color",
    "label": "Background Color",
    "default": "#000000"
  }
  ],
  "blocks": [
    {
      "type": "social",
      "name": "Social Link",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Select Platform",
          "options": [
            { "value": "facebook", "label": "Facebook" },
            { "value": "instagram", "label": "Instagram" },
            { "value": "youtube", "label": "YouTube" },
            { "value": "twitter", "label": "Twitter" },
            { "value": "tiktok", "label": "TikTok" },
            { "value": "email", "label": "Email" }
          ],
          "default": "facebook"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Social Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Social Media Section"
    }
  ]
}
{% endschema %}

{% stylesheet %}


.social-section {
  padding: 30px 20px;
  text-align: center;
  /* {% comment %} background :#000; {% endcomment %} */
}

.social-section h2 {
  font-size: 28px;
  margin-bottom: 25px;
}

.social-icons {
  display: flex;
  justify-content: center;
  gap: 20px;
  flex-wrap: wrap;
}

.social-icons a {
  width: 50px;
  height: 50px;
  /* {% comment %} background: #fddc00; {% endcomment %} */
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: 0.3s;
  border: 2px solid #000;
}

.social-icons a:hover {
  /* {% comment %} background: #ff6600; {% endcomment %} */
  transform: scale(1.1);
}

.social-icons svg {
  width: 22px;
  height: 22px;
  /* {% comment %} fill: #fff; {% endcomment %} */
}




{% endstylesheet %}


<div class="social-section" style="background: {{ section.settings.bg_color }};">

{% comment %} <div class="social-section"> {% endcomment %}
  <h2>{{ section.settings.heading }}</h2>

  <div class="social-icons">
    {% for block in section.blocks %}
      <a href="{{ block.settings.link }}" target="_blank">
        
        {% case block.settings.icon %}

