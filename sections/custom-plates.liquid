{% schema %}
{
  "name": "Hero - Custom Plates",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "tag",
      "label": "Top Tag",
      "default": "PREMIUM QUALITY"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Precision-crafted plates, built to the highest standard and delivered fast."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Build Your Plate"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 50
    }
  ],
  "presets": [
    {
      "name": "Hero - Custom Plates"
    }
  ]
}
{% endschema %}

<section class="hero-section">
  <div class="hero-bg" style="background-image: url({{ section.settings.bg_image | image_url: width: 2000 }});">
    <div class="overlay"><span></span></div>

    <div class="hero-content">
      
      {% if section.settings.tag != blank %}
        <div class="hero-tag">{{ section.settings.tag }}</div>
      {% endif %}

      <h1 class="hero-heading">{{ section.settings.heading }}</h1>

      <p class="hero-subheading">{{ section.settings.subheading }}</p>

      {% if section.settings.button_text != blank %}
        <a href="{{ section.settings.button_link }}" class="hero-btn">
          {{ section.settings.button_text }}
        </a>
      {% endif %}

      <div class="hero-trust">
        <span><span class="tick">✔</span>Road Legal Options Available</span>
        <span><span class="tick">✔</span>Premium Quality Materials</span>
        <span><span class="tick">✔</span>Fast UK Delivery</span>
        <span><span class="tick">✔</span>Made to Order</span>
      </div>

    </div>
  </div>
</section>

<style>
.hero-section {
  position: relative;
}

.hero-bg {
  position: relative;
  background-size: cover;
  background-position: center;
  padding: 120px 20px;
  text-align: center;
  color: #fff;
}

{% comment %} .overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.5);
} {% endcomment %}

.overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: rgba(
    {{ section.settings.overlay_color.red }},
    {{ section.settings.overlay_color.green }},
    {{ section.settings.overlay_color.blue }},
    {{ section.settings.overlay_opacity | divided_by: 100.0 }}
  );
}


.hero-content {
  position: relative;
  z-index: 2;
  max-width: 900px;
  margin: 0 auto;
}

.hero-tag {
  display: inline-block;
  background: #5a2699;
  {% comment %} background: #ffd600; {% endcomment %}
  color: #000;
  padding: 6px 14px;
  border-radius: 20px;
  font-weight: 600;
  font-size: 12px;
  margin-bottom: 20px;
}

.hero-heading {
    font-size: 48px;
    font-weight: 800;
    margin-bottom: 15px;
    TEXT-TRANSFORM: UPPERCASE;
    COLOR: #FFF;
    font-family: 'Poppins';
}
.hero-heading em {
  color :#5a2699;
    {% comment %} color: #ffd600; {% endcomment %}
}
.hero-heading {
  color: white; /* text color */
  -webkit-text-stroke: 1.5px white; /* border color */
}

.hero-subheading {
  font-size: 18px;
  margin-bottom: 25px;
  color: #f5f5f5;
}

.hero-btn {
  display: inline-block;
  background : #5a2699;
  color :  #fff;
  {% comment %} background: #ffd600; {% endcomment %}
  {% comment %} color: #000; {% endcomment %}
  padding: 14px 28px;
  font-weight: 700;
  border-radius: 6px;
  text-decoration: none;
  transition: all 0.3s ease;
}

.hero-btn:hover {
  background : #5a2699;
  {% comment %} background: #e6c200; {% endcomment %}
  transform: scale(1.05);
}

.hero-trust {
  margin-top: 30px;
  display: flex;
  justify-content: center;
  gap: 15px;
  flex-wrap: wrap;
}

.hero-trust span {
  background: #000;
  padding: 8px 8px;
  border-radius: 20px;
  font-size: 14px;
}


{% comment %} 
.overlay {
  position: absolute;
  inset: 0;
  background: {{ section.settings.overlay_color }};
  opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
} {% endcomment %}

.overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: rgba(
    {{ section.settings.overlay_color.red }},
    {{ section.settings.overlay_color.green }},
    {{ section.settings.overlay_color.blue }},
    {{ section.settings.overlay_opacity | divided_by: 100.0 }}
  );
}
.overlay {
  z-index: 1;
}

.hero-bg::before {
  z-index: 0;
}

/* 📱 MOBILE */
@media (max-width: 768px) {

  .hero-bg {
    padding: 80px 15px;
  }

  .hero-heading {
    font-size: 28px;
    line-height: 1.3;
  }

  .hero-subheading {
    font-size: 14px;
  }

  .hero-btn {
    width: 100%;
    padding: 16px;
    font-size: 16px;
  }

  .hero-trust {
    flex-direction: column;
    gap: 10px;
  }

  .hero-trust span {
    font-size: 13px;
  }
}



.hero-trust {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.hero-trust span {
  color: #fff; /* text color */
  font-size: 14px;
}

.hero-trust .tick {
  color : #5a2699;
  {% comment %} color: #ffd600; /* BLUE tick */ {% endcomment %}
  font-weight: bold;
  margin-right: 6px;
}


.hero-content {
    position: relative;
    z-index: 2;
    max-width: 900px;
    margin: 0 auto 150px auto;
}


.hero-trust{
display: none;
}

</style>